# Copy values into the service environment; this file is not loaded implicitly.
ARENA_API_DATA=.platform-state
ARENA_API_ORIGIN=http://127.0.0.1:4181
ARENA_API_COOKIE_SECURE=0
# Graders are configured separately with --backend / --slots; see docs/thiet-ke.md.
ARENA_CONNECTION_LIMIT=1024
# Empty by default. Only list CIDRs of actual reverse proxies.
# ARENA_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Optional absolute path. Default is the sibling uet-bot-arena/dist checkout.
# ARENA_UI_ROOT=/srv/uet-arena/uet-bot-arena/dist
# For public hosting, set an exact HTTPS origin and COOKIE_SECURE=1.
# No default account or password. Bootstrap admin via the CLI's hidden prompt.
