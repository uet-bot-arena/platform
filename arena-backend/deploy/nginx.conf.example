# Template only. Put the zone directives inside nginx's http {} block.
limit_req_zone $binary_remote_addr zone=arena_api:10m rate=100r/s;
limit_req_zone $binary_remote_addr zone=arena_login:10m rate=10r/s;

server {
    listen 443 ssl;
    server_name arena.example.edu;
    ssl_certificate /etc/letsencrypt/live/arena.example.edu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/arena.example.edu/privkey.pem;
    client_max_body_size 10m;
    limit_req_status 429;

    location = /api/v1/auth/login {
        limit_req zone=arena_login burst=100 nodelay;
        proxy_pass http://127.0.0.1:4181;
        proxy_set_header Host $http_host;
        # Configure ARENA_TRUSTED_PROXIES=127.0.0.1/32,::1/128 on the API.
        # Overwrite client-supplied forwarding headers at this public edge.
        proxy_set_header X-Forwarded-For $remote_addr;
        # Do not log request bodies, cookies or passwords.
    }
    location /api/ {
        # Classroom NAT: allow viewers and team polling behind one address.
        limit_req zone=arena_api burst=512 nodelay;
        proxy_pass http://127.0.0.1:4181;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 75s;
    }
    location = /openapi.json {
        proxy_pass http://127.0.0.1:4181;
        proxy_set_header Host $http_host;
    }
    location /docs {
        proxy_pass http://127.0.0.1:4181;
        proxy_set_header Host $http_host;
    }
    location / {
        # Serve the API-connected UI, not the old static demo index.html.
        # ARENA_UI_ROOT points at the sibling uet-bot-arena/dist checkout.
        proxy_pass http://127.0.0.1:4181;
        proxy_set_header Host $http_host;
    }
}
